    "@types/node": "^20",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "jsdom": "27.1.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.3",
    "typed-css-modules": "^0.9.1",
