    "compression": "^1.7.5",
    "express": "5.2.1",
    "http-proxy-middleware": "4.2.0",
    "isbot": "^5.1.27",
    "mime-types": "^3.0.1",
    "morgan": "1.11.0",
    "react": "19.2.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.0",
    "react-dropzone": "^14.3.8",
    "react-router": "7.18.2",
